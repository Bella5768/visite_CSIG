# Configuration Email - Copiez ce fichier en .env et remplissez vos valeurs

# Fournisseur Gmail (recommandé)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
DEFAULT_FROM_EMAIL=votre_email@gmail.com

# Alternative: Outlook/Hotmail
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Alternative: Yahoo
# EMAIL_HOST=smtp.mail.yahoo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Alternative: Orange
# EMAIL_HOST=smtp.orange.fr
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# Alternative: Autres fournisseurs
# EMAIL_HOST=smtp.votre-fournisseur.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
